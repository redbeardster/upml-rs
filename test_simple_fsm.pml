/*
 * Generated Promela FSM model for state machine: test_simple_fsm
 * Generated by upml-rs
 */

/* Message types (events) */
mtype = {
    EnterState,
    ExitState,
    Failure,
    Finish,
    NullEvent,
    Retry,
    Start
};

/* State enumeration */
mtype = {
    state_Completed,
    state_Error,
    state_Idle,
    state_Processing
};

/* Global variables */
mtype currentState;
mtype event;
chan eventQueue = [16] of { mtype };
bool inTransition = false;

/* Main FSM process */
active proctype StateMachine() {
    currentState = state_Idle; 
    
    do
    :: eventQueue?event ->
        atomic {
            inTransition = true;
            
            /* State transitions */
            if
            :: (currentState == state_Completed && event == NullEvent) ->
                    goto end_state;
            :: else -> skip
            fi
            if
            :: (currentState == state_Processing && event == Failure) ->
                    currentState = state_Error;
            :: else -> skip
            fi
            if
            :: (currentState == state_Processing && event == Finish) ->
                    currentState = state_Completed;
            :: else -> skip
            fi
            if
            :: (currentState == state_Idle && event == Start) ->
                    currentState = state_Processing;
            :: else -> skip
            fi
            if
            :: (currentState == state_Error && event == Retry) ->
                    currentState = state_Idle;
            :: else -> skip
            fi
            
            inTransition = false;
        }
    od
    
end_state:
    /* Final state reached - process terminates */
}

/* LTL Properties */
/* Basic liveness: eventually reach a final state */
ltl liveness { <>( currentState == state_Completed ) }
ltl safety { [](!inTransition -> <>inTransition) }
