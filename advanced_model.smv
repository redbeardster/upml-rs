-- Generated NuSMV model for state machine: parsed_machine
-- Generated by upml-rs
-- NuSMV symbolic model checker format

MODULE main

VAR
  state : {Processing, Error, Idle, Completed};
  event : {Success, EnterState, Retry, Failure, ExitState, NullEvent, Reset, Start};

ASSIGN
  init(state) := Idle;
  next(state) := case
    state = Error & event = Retry : Processing;
    state = Error & event = Reset : Idle;
    state = Processing & event = Failure : Error;
    state = Processing & event = Success : Completed;
    state = Completed & event = NullEvent : Completed;
    state = Idle & event = Start : Processing;
    TRUE : state;
  esac;


-- Fairness Constraints
-- These constraints ensure fair execution paths
FAIRNESS event = Success -- Event Success should be eventually possible
FAIRNESS event = Reset -- Event Reset should be eventually possible
FAIRNESS event = Start -- Event Start should be eventually possible
FAIRNESS event = Retry -- Event Retry should be eventually possible
FAIRNESS event = Failure -- Event Failure should be eventually possible
FAIRNESS !(state = Idle & event = Start) -- Fair transition from Idle on Start
FAIRNESS !(state = Processing & event = Failure) -- Fair transition from Processing on Failure
FAIRNESS !(state = Processing & event = Success) -- Fair transition from Processing on Success
FAIRNESS !(state = Error & event = Retry) -- Fair transition from Error on Retry
FAIRNESS !(state = Error & event = Reset) -- Fair transition from Error on Reset


-- Temporal Logic Specifications

-- Reachability Properties
SPEC EF (state = Processing) -- Processing should be reachable
SPEC EF (state = Error) -- Error should be reachable
SPEC EF (state = Completed) -- Completed should be reachable
-- Final states: {"Completed"}

-- Safety Properties
SPEC AG (state = Error -> EX TRUE) -- No deadlock from Error
SPEC AG (state = Processing -> EX TRUE) -- No deadlock from Processing
SPEC AG (state = Idle -> EX TRUE) -- No deadlock from Idle

-- Liveness Properties
SPEC AG (state = Idle -> AF (state = Completed)) -- From Idle eventually reach final state

-- Advanced Properties
-- State mutual exclusion is guaranteed by design
SPEC AG (state = Error -> EF (state = Completed)) -- From Error can reach final states
SPEC AG (state = Processing -> EF (state = Completed)) -- From Processing can reach final states
-- Determinism Properties

-- Custom User-Defined Properties
SPEC AG (state = Error -> EF (state != Error)) -- Custom property 1
SPEC AG EF (state = Idle) -- Custom property 2
SPEC EF (state = Completed) -- Custom property 3

