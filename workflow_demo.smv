-- Safety Properties
SPEC AG (state = Validating -> EX TRUE) -- No deadlock from Validating
SPEC AG (state = Computing -> EX TRUE) -- No deadlock from Computing
SPEC AG (state = Initializing -> EX TRUE) -- No deadlock from Initializing
SPEC AG (state = ValidationError -> EX TRUE) -- No deadlock from ValidationError
SPEC AG (state = Processing -> EX TRUE) -- No deadlock from Processing

-- Liveness Properties
SPEC AG (state = Initializing -> AF (state = Saving | state = Ready | state = ErrorState)) -- From Initializing eventually reach final state
SPEC AG (state = Validating -> AF (state = Saving | state = Ready | state = ErrorState)) -- From Validating eventually reach final state

-- Advanced Properties
-- State mutual exclusion is guaranteed by design
SPEC AG (state = Processing -> EF (state = ErrorState | state = Ready | state = Saving)) -- From Processing can reach final states
