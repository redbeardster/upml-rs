-- Generated by upml-rs
-- NuSMV symbolic model checker format

MODULE main

VAR
  state : {Ready, ErrorState, Validating, Computing, ValidationError, Processing, Initializing, Saving};
  event : {ValidationPassed, ErrorRecovered, ValidationFailed, ComputationComplete, NullEvent, Start, EnterState, CriticalError, Retry, SystemShutdown, SaveComplete, ProcessComplete, ExitState, InitComplete, Shutdown};

ASSIGN
  init(state) := {Initializing, Validating};
  next(state) := case
    state = Validating & event = ValidationFailed : ValidationError;
    state = Validating & event = ValidationPassed : Computing;
    state = Computing & event = ComputationComplete : Saving;
    state = Processing & event = ProcessComplete : Ready;
    state = Processing & event = CriticalError : ErrorState;
    state = Initializing & event = InitComplete : Ready;
    state = Ready & event = SystemShutdown : Ready;
    state = Ready & event = Start : Processing;
    state = Saving & event = SaveComplete : Saving;
    state = ValidationError & event = Retry : Validating;
    state = ErrorState & event = ErrorRecovered : Ready;
    state = ErrorState & event = Shutdown : ErrorState;
    TRUE : state;
  esac;


-- Temporal Logic Specifications

-- Reachability Properties
SPEC EF (state = Saving) -- Saving should be reachable
SPEC EF (state = Ready) -- Ready should be reachable
SPEC EF (state = ValidationError) -- ValidationError should be reachable
SPEC EF (state = ErrorState) -- ErrorState should be reachable
SPEC EF (state = Computing) -- Computing should be reachable
